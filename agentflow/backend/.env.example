# --- Model provider configuration ---
# Provider selection: auto | offline | openai | gemini
# auto picks the provider that has a key configured (gemini > openai).
# If no key is set, it falls back to offline mock mode (no API needed).
LLM_PROVIDER=auto

# Force offline mock mode (ignores keys below)
FORCE_OFFLINE=false

# --- Gemini (Google AI Studio) ---
# Get a free key at https://aistudio.google.com/apikey
USER_GEMINI_API_KEY=
USER_GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI-compatible providers (DeepSeek, OpenRouter, etc.) ---
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# --- Generation ---
LLM_TEMPERATURE=0.7
# Simulated token delay in ms (used for a nicer streaming demo in offline mode)
TOKEN_DELAY_MS=18

# --- App ---
# Switch to PostgreSQL in production, e.g. postgresql://user:pass@host:5432/agentflow
DATABASE_URL=sqlite:///./agentflow.db
CORS_ORIGINS=*
